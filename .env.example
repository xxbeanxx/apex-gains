# Postgres connection string used by the app and drizzle-kit.
# Points at a Supabase project's "Session pooler" connection string
# (Project Settings > Database > Connection string > Session pooler in the
# Supabase dashboard) - IPv4-compatible and supports prepared statements,
# unlike the transaction pooler. Falls back to local podman Postgres
# (see deploy/postgres-pod.yaml) if you'd rather not depend on Supabase
# for local dev.
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Google OAuth/OIDC credentials from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: <ORIGIN>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL the app is served from (used to build the OIDC redirect URI).
ORIGIN=http://localhost:5173

# Random string used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
