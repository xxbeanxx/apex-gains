{
  "include": ["**/*", "**/.server/**/*", "**/.client/**/*", ".react-router/types/**/*"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./app/*"],
      "~server/*": ["./server/*"]
    },
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    // Nest's decorators only need `experimentalDecorators`. There is
    // deliberately no `emitDecoratorMetadata`: esbuild - used by Vite and by
    // `tsx`, which is what actually runs `server/` - never emits
    // `design:paramtypes`, so implicit type-based DI does not work here.
    // Every `@Injectable()` constructor parameter must carry an explicit
    // `@Inject(TOKEN)`; a missing one fails at DI-resolution time with
    // "Nest can't resolve dependencies", not as a type error.
    "experimentalDecorators": true
  }
}
